#!/bin/sh
# installation-edit: save configuration and keep/remove choices without installing.
# The protocol is docs/installation-edit.txt.
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo 'installation-edit: not a Git repository' >&2; exit 2;
}
[ "$root" -ef . ] || {
    echo 'installation-edit: run at the repository root' >&2; exit 2;
}
exec emacs -Q --batch --eval '(setq backtrace-on-error-noninteractive nil)' \
    -l /usr/local/share/clankos/lisp/clankos-packages.el \
    -l /usr/local/share/clankos/lisp/clankos-installation.el \
    -f clankos-installation-edit-batch "$@"
