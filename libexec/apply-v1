#!/bin/sh
# Print apply-v1 input for the host's skills container. docs/apply-v1.txt.
[ $# -eq 0 ] || { echo 'Usage: apply-v1' >&2; exit 2; }
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo 'apply-v1: not a Git repository' >&2; exit 2;
}
[ "$root" -ef . ] || { echo 'apply-v1: run at the repository root' >&2; exit 2; }
exec emacs -Q --batch --eval '(setq backtrace-on-error-noninteractive nil)' \
    -l /usr/local/share/clankos/lisp/clankos-packages.el \
    -l /usr/local/share/clankos/lisp/clankos-installation.el \
    -f clankos-installation-apply-batch
