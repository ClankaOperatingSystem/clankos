#!/bin/sh
# installation-plan: print a read-only repository plan as JSON.
# The protocol is docs/installation-plan.txt.
[ $# -eq 0 ] || { echo 'Usage: installation-plan' >&2; exit 2; }
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo 'installation-plan: not a Git repository' >&2; exit 2;
}
[ "$root" -ef . ] || {
    echo 'installation-plan: run at the repository root' >&2; exit 2;
}
exec emacs -Q --batch --eval '(setq backtrace-on-error-noninteractive nil)' \
    -l /usr/local/share/clankos/lisp/clankos-packages.el \
    -l /usr/local/share/clankos/lisp/clankos-installation.el \
    -f clankos-installation-plan-batch
