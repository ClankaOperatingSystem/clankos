#!/bin/sh
# initiate [--ask] [--image TAG] [--archive committed|uncommitted|remote]
#          [--keeper URL] [--no-tree] [--project]
# Make the Git repository in the working directory a garden, or with
# --project a project to be mounted in one. The protocol is
# docs/initiate.txt.
usage() {
    echo "Usage: initiate [--ask] [--image TAG] [--archive committed|uncommitted|remote] [--keeper URL] [--no-tree] [--project]" >&2
    exit 2
}
refuse() {
    echo "initiate: $1" >&2
    exit 2
}

registry=ghcr.io/clankaoperatingsystem/clankos
ask=
[ ! -t 0 ] || ask=1
tag= archive= keeper= tree=1 project=
while [ $# -gt 0 ]; do
    case $1 in
        --ask) ask=1; shift ;;
        --no-tree) tree=; shift ;;
        --project) project=1 tree=; shift ;;
        --image) [ $# -ge 2 ] || usage; tag=$2; shift 2 ;;
        --archive) [ $# -ge 2 ] || usage; archive=$2; shift 2 ;;
        --keeper) [ $# -ge 2 ] || usage; keeper=$2; shift 2 ;;
        *) usage ;;
    esac
done

[ -e .git ] || refuse "not the root of a Git repository: $PWD"
config=
for file in .clanka/config.yaml .clanka/config.yml .clankos/config.yaml .clankos/config.yml .pos/config.yaml .pos/config.yml; do
    if [ -f "$file" ]; then
        [ -z "$config" ] || refuse "two configurations: $config, $file"
        config=$file
    fi
done

# question PROMPT DEFAULT: the answer, or DEFAULT if none is given or asked for.
question() {
    answer=
    if [ -n "$ask" ]; then
        printf '%s [%s]: ' "$1" "$2" >&2
        read -r answer || answer=
    fi
    printf '%s\n' "${answer:-$2}"
}

if [ -n "$config" ]; then
    echo "kept      $config (this is a garden already)"
else
    [ -n "$tag" ] || tag=$(cat /usr/local/share/clankos-release)
    case $tag in
        ''|latest|*[!A-Za-z0-9._-]*) refuse "not an image tag: $tag" ;;
    esac
    [ -n "$archive" ] || archive=$(question "The archive: uncommitted (on disk, ignored by Git), committed, or remote (kept by a keeper)" uncommitted)
    case $archive in
        committed|uncommitted) [ -z "$keeper" ] || refuse "only a remote archive has a keeper" ;;
        remote)
            [ -n "$keeper" ] || keeper=$(question "The keeper's address for this archive" "")
            case $keeper in
                https://*|http://*) ;;
                *) refuse "a remote archive needs its keeper's address, as --keeper URL" ;;
            esac
            case $keeper in
                *[[:space:]\"\'#]*) refuse "not an address: $keeper" ;;
            esac ;;
        *) refuse "the archive is kept committed, uncommitted or remote, not: $archive" ;;
    esac

    config=.clanka/config.yml
    mkdir -p .clanka
    {
        # A project is a leaf, and says nowhere that projects belong.
        printf 'pos: 2\n'
        [ -n "$project" ] || printf 'projects: projects/\n'
        printf 'image: %s:%s\n' "$registry" "$tag"
        # The directories no command reads, written out so that a reader
        # of the file can see why; these are what poslib assumes when a
        # node declares none.
        printf 'exclude:\n  - archives\n  - attic\n  - node_modules\n  - "_*"\n  - ".*"\n'
        case $archive in
            committed) printf 'archives:\n  - scope: "."\n    kept: committed\n    sweep: sealed\n' ;;
            remote) printf 'archives:\n  - scope: "."\n    kept: remote\n    url: %s\n    sweep: sealed\n' "$keeper" ;;
        esac
    } > "$config"
    echo "wrote     $config (image $tag, archive $archive)"
fi

# ignore LINE: add LINE to .gitignore unless it is there.
ignore() {
    if [ -f .gitignore ] && grep -qxF "$1" .gitignore; then
        return
    fi
    [ ! -s .gitignore ] || [ -z "$(tail -c 1 .gitignore)" ] || printf '\n' >> .gitignore
    printf '%s\n' "$1" >> .gitignore
    echo "ignored   $1 in .gitignore"
}
ignore '_*/'

if [ -e intray.org ]; then
    echo "kept      intray.org"
else
    printf ':PROPERTIES:\n:ID:       %s\n:END:\n#+TITLE: Intray\n\n* Unsorted\n' \
        "$(cat /proc/sys/kernel/random/uuid)" > intray.org
    echo "wrote     intray.org"
fi

# AGENTS.md: one marked block, which sends its reader to the skills,
# and to the image's own help for what a garden is. The file is made if it is missing; in a file that is there,
# only the block is written, and what surrounds it is kept.
begin='<!-- clankos: begin -->'
end='<!-- clankos: end -->'
block() {
    cat <<BLOCK
$begin
## ClankOS

This repository is a ClankOS garden: a tree of responsibilities kept
in Org files. Its skills are in .agents/skills/. Each skill carries the
scripts it needs; run them by their path from the working directory.

Use the skill that fits the work. For an account of the garden and its
commands, run .agents/skills/clankos-bootstrap/scripts/clankos help.

Search within this repository, not the user's home or the rest of the
machine, unless asked.

To apply configured skill sources, run
.agents/skills/clankos-bootstrap/scripts/clankos apply-v1 at the repository
root. Apply installs method zero and optional configured sources, and keeps
ownership in installation-state.json beside the root configuration.
Review and commit configuration, ownership, skills and skills-lock.json
together. Apply never stages or commits. Separate repositories need their
own apply. A fresh clone uses its committed bundles directly.

The bootstrap skill writes this block. Write outside it.
$end
BLOCK
}
if [ ! -e AGENTS.md ]; then
    block > AGENTS.md
    echo "wrote     AGENTS.md"
elif [ ! -f AGENTS.md ]; then
    echo "kept      AGENTS.md (it is not a file)"
elif ! grep -qxF "$begin" AGENTS.md; then
    [ ! -s AGENTS.md ] || [ -z "$(tail -c 1 AGENTS.md)" ] || printf '\n' >> AGENTS.md
    [ ! -s AGENTS.md ] || printf '\n' >> AGENTS.md
    block >> AGENTS.md
    echo "added     the ClankOS block to AGENTS.md"
elif ! grep -qxF "$end" AGENTS.md; then
    echo "kept      AGENTS.md (its ClankOS block has no end)"
else
    agents=$(mktemp)
    block > "$agents.block"
    awk -v begin="$begin" -v end="$end" -v block="$agents.block" '
        $0 == begin && !done { while ((getline line < block) > 0) print line; skip = 1; done = 1; next }
        skip { if ($0 == end) skip = 0; next }
        { print }
    ' AGENTS.md > "$agents"
    if cmp -s "$agents" AGENTS.md; then
        echo "kept      AGENTS.md"
    else
        cat "$agents" > AGENTS.md
        echo "updated   the ClankOS block in AGENTS.md"
    fi
    rm -f "$agents" "$agents.block"
fi

# The configuration as poslib reads it.
emacs -Q --batch --eval '(setq backtrace-on-error-noninteractive nil)' \
    -l /usr/local/share/clankos/lisp/clankos-packages.el -l pos-node \
    --eval '(pos-node-read-config (with-temp-buffer (insert-file-contents (car command-line-args-left)) (setq command-line-args-left nil) (buffer-string)))' \
    "$config" 2>/dev/null || refuse "poslib refuses $config"

# Read the saved configuration, including each existing child's policy.
emacs -Q --batch --eval '(setq backtrace-on-error-noninteractive nil)' \
    -l /usr/local/share/clankos/lisp/clankos-packages.el -l pos-tree \
    --eval '(let ((plan (pos-tree-ignore-archives default-directory)))
              (seq-doseq (f (alist-get (quote findings) plan))
                (let-alist f (princ (format "finding   %s %s\n" .finding .path)))))' \
    || refuse "could not configure archive exclusions"

if [ -n "$tree" ] && [ -n "$ask" ]; then
    "$(dirname -- "$0")/responsibility-tree" --ask || true
fi

echo
if [ -n "$project" ]; then
    echo "This repository is a project. Nothing is committed: read git status, and commit."
    echo "Mount it where a responsibility keeps its projects, with responsibility-tree there."
else
    echo "This repository is a garden. Nothing is committed: read git status, and commit."
    echo "Add to the tree with the clankos-tree skill."
fi
echo "The bundled clankos help command describes the garden."
