#!/bin/sh
# methodology [--ask] add SOURCE REF [SKILL ...] [--kind KIND]
# methodology [--ask] remove SOURCE [SKILL ...] [--keep]
# methodology [--ask] adopt SKILL ...
# Change the sources the configuration of the node in the working
# directory declares, and print the names of the skills that install is
# to uninstall with them, one a line. bin/clankos-run runs install
# afterwards; docs/methodology.txt is the protocol. --ask asks, on
# stderr, whether to uninstall the skills of a source removed whole;
# without it they are uninstalled unless --keep is given.
# Exit: 0 changed, or declared so already; 1 refused, and nothing was
# changed; 2 usage, or no configuration here.
ask=
[ "${1:-}" != --ask ] || { ask=1; shift; }
out=$(emacs -Q --batch --eval '(setq backtrace-on-error-noninteractive nil)' \
    -l /usr/local/share/clankos/lisp/clankos-packages.el -l pos-node -l pos-sources \
    --eval '
(let* ((args command-line-args-left)
       (action (car args))
       (kind nil) (keep nil) (words nil))
  (setq command-line-args-left nil)
  (cl-flet ((usage ()
              (message "Usage: methodology add SOURCE REF [SKILL ...] [--kind KIND]")
              (message "       methodology remove SOURCE [SKILL ...] [--keep]")
              (message "       methodology adopt SKILL ...")
              (kill-emacs 2)))
    (setq args (cdr args))
    (while args
      (let ((arg (pop args)))
        (cond ((and (equal arg "--kind") (equal action "add") args)
               (setq kind (pop args)))
              ((and (equal arg "--keep") (equal action "remove"))
               (setq keep t))
              ((string-prefix-p "-" arg) (usage))
              (t (push arg words)))))
    (setq words (nreverse words))
    (unless (pcase action
              ("add" (>= (length words) 2))
              ((or "remove" "adopt") words))
      (usage)))
  (let ((file (condition-case err
                  (pos-node-config-file default-directory)
                (pos-node-refused
                 (message "methodology: %s: %s" (nth 1 err) (nth 2 err))
                 (kill-emacs 2)))))
    (unless file
      (message "methodology: no configuration in %s; run it in a node"
               (directory-file-name default-directory))
      (kill-emacs 2))
    (condition-case err
        (let* ((text (with-temp-buffer (insert-file-contents file) (buffer-string)))
               (removed (and (equal action "remove")
                             (pos-sources-remove text default-directory
                                                 (car words) (cdr words))))
               (new (pcase action
                      ("add" (pos-sources-add text (nth 0 words) (nth 1 words)
                                              (nthcdr 2 words) kind))
                      ("remove" (alist-get (quote text) removed))
                      ("adopt" (pos-sources-adopt text default-directory words)))))
          (when (and keep (not (alist-get (quote whole) removed)))
            (message "methodology: --keep keeps the skills of a source removed whole; install removes a skill its source no longer names")
            (kill-emacs 1))
          (if (equal new text)
              (message "methodology: %s declares this already" file)
            (with-temp-file file (insert new))
            (message "methodology: changed %s" file))
          (unless keep
            (when (alist-get (quote whole) removed)
              (princ "whole\n"))
            (dolist (name (alist-get (quote skills) removed))
              (princ (concat "skill " name "\n")))))
      (pos-node-refused
       (message "methodology: %s" (nth 2 err))
       (kill-emacs 1)))))' \
    "$@") || exit
names=$(printf '%s\n' "$out" | sed -n 's/^skill //p')
[ -n "$names" ] || exit 0
if [ -n "$ask" ] && printf '%s\n' "$out" | grep -qx whole; then
    printf 'Uninstall %s too? [Y/n] ' "$(printf '%s\n' "$names" | paste -sd ' ' -)" >&2
    read -r reply || reply=
    case $reply in
        ''|[Yy]|[Yy][Ee][Ss]) ;;
        *) exit 0 ;;
    esac
fi
printf '%s\n' "$names"
