#!/bin/sh
# refresh [--if-changed]
# Bring what ClankOS installs in the repository the working directory
# is in to what this image holds. The protocol is docs/refresh.txt.
# With --if-changed, which run gives before a command, nothing is read
# again when the image and the paths that refresh reads are as they
# were after the last refresh: what it said is said again, and its exit
# status is the exit status.
# Exit: 0 done, 1 a name is taken, or a skills-lock.json differs from
# its configuration, 2 usage, 3 a link cannot be made.
changed=
if [ "${1:-}" = --if-changed ]; then
    changed=1
    shift
fi
if [ $# -ne 0 ]; then
    echo "Usage: refresh [--if-changed]" >&2
    exit 2
fi
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
source=/usr/local/share/clankos/source

# What the last refresh saw is kept in the auto/ of the repository's
# configuration directory, in refresh/.
kept=
for dir in .clanka .clankos .pos; do
    if [ -d "$root/$dir/auto" ]; then
        kept=$root/$dir/auto/refresh
        break
    fi
done
# The directory is made now, so that its appearance in auto/ is not a
# change the first refresh after it made the directory would see.
[ -z "$kept" ] || mkdir -p "$kept"

# The paths refresh reads: the configuration directories, the skills,
# the lock files, the directories of links, Codex's rules, and Git's
# info/exclude.
listed() {
    find "$root" \( -name .git -o -name '_*' -o -name node_modules \
            -o -name archives -o -name attic -o -path '*/auto/refresh' \) -prune \
        -o \( -path '*/.clanka' -o -path '*/.clanka/*' -o -path '*/.clankos' \
            -o -path '*/.clankos/*' -o -path '*/.pos' -o -path '*/.pos/*' \
            -o -path '*/.agents/skills' -o -path '*/.agents/skills/*' \
            -o -name skills-lock.json -o -name bin -o -path '*/bin/*' \
            -o -path '*/.codex/rules' -o -path '*/.codex/rules/*' \) -print
    git -C "$root" rev-parse --path-format=absolute --git-path info/exclude
}

# A digest of the image's version and commit, and of each path in the file $1: a
# directory's entries, or a file's content, or that it is gone. Both are
# read by opening the path: a time of change that Docker's shared folder
# gives can be seconds old.
signature() {
    {
        cat "$source/version" "$source/commit"
        tr '\n' '\0' < "$1" | xargs -0 -r sh -c '
            for path; do
                if [ -d "$path" ] && [ ! -L "$path" ]; then
                    printf "%s/\n" "$path"
                    ls -1A -- "$path"
                fi
            done' sh
        tr '\n' '\0' < "$1" | xargs -0 -r sha256sum -- 2>&1 | grep -v ': Is a directory$'
    } | sha256sum
}

# Codex's approvals: in each repository the source is installed in,
# .codex/rules/clankos.rules holds a rule for each way the repository,
# and each configured repository beneath it, has of starting a command,
# so that Codex runs ClankOS's commands without asking: docs/refresh.txt,
# section 1. A way is a link to a command in an auto/bin/, or a skill's
# scripts/clankos; a rule gives it relative to the repository, with ./
# before it, and absolute. The file is untracked, its path in
# info/exclude, and replaced whole when what it lists changes. Where
# the repository tracks a file of that name, it is left and reported
# as a taken name. Prints what it reports; exits 1 for a taken name.
# pruned TEST ...: the paths under the root that pass TEST, less what
# listed leaves out.
pruned() {
    find "$root" \( -name .git -o -name '_*' -o -name node_modules \
            -o -name archives -o -name attic \) -prune -o "$@" -print
}

approvals() {
    rules=.codex/rules/clankos.rules
    taken=0
    pruned \( -type l -o -path '*/.agents/skills/*/scripts/clankos' \) \
        | while IFS= read -r path; do
            if [ -L "$path" ]; then
                case $(readlink "$path") in
                    */auto/bin/*) ;;
                    *) continue ;;
                esac
            elif [ ! -f "$path" ] || [ ! -x "$path" ]; then
                continue
            fi
            printf '%s\n' "${path#"$root"/}"
        done | LC_ALL=C sort > "$work/entries"
    pruned \( -path '*/.clanka/auto/version' -o -path '*/.clankos/auto/version' \
            -o -path '*/.pos/auto/version' \) | LC_ALL=C sort > "$work/repos"
    while IFS= read -r version; do
        repo=${version%/.*/auto/version}
        rel=${repo#"$root"}
        rel=${rel#/}
        file=$repo/$rules
        if git -C "$repo" ls-files --error-unmatch -- "$rules" >/dev/null 2>&1; then
            added=$(git -C "$repo" log --diff-filter=A --format=%h -1 -- "$rules")
            echo "clankos: name-taken ${rel:+$rel/}$rules (tracked, added in $added)"
            taken=1
            continue
        fi
        at=$(printf '%s' "$repo" | sed 's/[\\"]/\\&/g')
        {
            echo '# Written by ClankOS before each of its commands, and replaced whole:'
            echo '# "clankos-run help refresh", section 1. Each rule is one way of'
            echo "# starting one of ClankOS's commands in this repository."
            while IFS= read -r entry; do
                case $rel in
                    '') ;;
                    *) case $entry in
                           "$rel"/*) entry=${entry#"$rel"/} ;;
                           *) continue ;;
                       esac ;;
                esac
                entry=$(printf '%s' "$entry" | sed 's/[\\"]/\\&/g')
                printf 'prefix_rule(pattern=[["%s", "./%s", "%s/%s"]], decision="allow")\n' \
                    "$entry" "$entry" "$at" "$entry"
            done < "$work/entries"
        } > "$work/rules"
        if ! cmp -s "$work/rules" "$file"; then
            if ! { mkdir -p "${file%/*}" && cp "$work/rules" "$file"; } 2> "$work/failed"; then
                echo "clankos: cannot write ${rel:+$rel/}$rules: $(cat "$work/failed")"
                continue
            fi
        fi
        exclude=$(git -C "$repo" rev-parse --path-format=absolute --git-path info/exclude)
        if ! grep -qxF "/$rules" "$exclude" 2>/dev/null; then
            mkdir -p "${exclude%/*}"
            [ ! -s "$exclude" ] || [ -z "$(tail -c1 "$exclude")" ] || echo >> "$exclude"
            echo "/$rules" >> "$exclude"
        fi
    done < "$work/repos"
    return $taken
}

if [ -n "$changed" ] && [ -n "$kept" ] && [ -f "$kept/signature" ] \
        && [ "$(signature "$kept/list")" = "$(cat "$kept/signature")" ]; then
    cat "$kept/said" >&2
    exit "$(cat "$kept/status")"
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
if [ -n "$kept" ]; then
    listed > "$work/list"
    signature "$work/list" > "$work/signature"
fi
emacs -Q --batch --eval '(setq backtrace-on-error-noninteractive nil)' \
    -l /usr/local/share/clankos/lisp/clankos-packages.el -l pos-tree \
    --eval '
(let ((root (pop command-line-args-left))
      (source (pop command-line-args-left))
      (taken 0)
      (refused 0)
      (locked 0))
  (condition-case err
      (seq-doseq (finding (alist-get (quote findings) (pos-tree-install root source)))
        (let-alist finding
          (cond
           ((equal .finding "name-taken")
            (setq taken (1+ taken))
            (message "clankos: name-taken %s (%s)" .path .detail))
           ((equal .finding "methodology-refused")
            (setq refused (1+ refused))
            (message "clankos: methodology-refused %s (%s)" .path .detail))
           ((member .finding (quote ("lock-differs" "lock-undeclared")))
            (setq locked (1+ locked))
            (message "clankos: %s %s (%s)" .finding .path .detail))
           ((equal .finding "wild-caught")
            (message "clankos: wild-caught %s (%s)" .path .detail)))))
    (pos-tree-refused
     (if (and (eq (nth 1 err) (quote failed))
              (string-match "\\`Cannot make a symbolic link at \\(.*\\): \\(.*\\)\\'"'"'"
                            (nth 2 err)))
         (progn
           (message "clankos: cannot make a symbolic link at %s: %s"
                    (match-string 1 (nth 2 err)) (match-string 2 (nth 2 err)))
           (kill-emacs 3))
       (message "clankos: refresh: %s: %s" (nth 1 err) (nth 2 err))
       (kill-emacs 2))))
  (when (> taken 0)
    (message "clankos: each holds a name ClankOS links to what it installs; rename or remove it"))
  (when (> refused 0)
    (message "clankos: each is a methodology with a skill not named after it; nothing of it is linked"))
  (when (> locked 0)
    (message "clankos: each is a skills-lock.json that differs from its configuration; run clankos-run install there"))
  (when (> (+ taken refused locked) 0)
    (kill-emacs 1)))' \
    "$root" "$source" 2> "$work/said"
status=$?
if [ "$status" -le 1 ]; then
    approvals >> "$work/said" || status=1
fi
cat "$work/said" >&2

# What was seen is kept only when refresh changed none of the paths, so
# that a change made while it ran is read by the next refresh. The
# first refresh after a change makes links, and the next one keeps it.
if [ -n "$kept" ] && [ "$status" -le 1 ] \
        && [ "$(signature "$work/list")" = "$(cat "$work/signature")" ]; then
    mkdir -p "$kept" && echo "$status" > "$work/status" \
        && cp "$work/list" "$work/signature" "$work/said" "$work/status" "$kept/"
fi
exit "$status"
