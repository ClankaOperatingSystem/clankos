#!/bin/sh
# run COMMAND [ARG ...]
# Run a ClankOS command inside the image. bin/clankos-run starts it.
# CLANKOS_PROBE, when set, names a file the host saw in the workspace:
# its absence here means the workspace was not shared with the container.
# Before most commands, refresh brings installed files to this image's
# version and reports names it cannot take.  Help, installation-plan,
# installation-edit, wild-caught and refresh skip this step.
# Initiate runs refresh itself.
# Exit: the command's own, 126 workspace not visible, 127 no such command.
if [ -n "${CLANKOS_PROBE:-}" ] && [ ! -e "$CLANKOS_PROBE" ]; then
    echo "clankos: the workspace is not visible in the container: $PWD" >&2
    echo "clankos: Docker may share only some host directories, such as the home directory" >&2
    exit 126
fi
command=$(dirname -- "$0")/${1:-}
case ${1:-} in
    ''|run|*/*) command= ;;
esac
if [ -z "$command" ] || [ ! -x "$command" ]; then
    echo "clankos: no such command: ${1:-}" >&2
    exit 127
fi
case $1 in
    help|initiate|refresh|wild-caught|installation-plan|installation-edit) ;;
    *) "$(dirname -- "$0")/refresh" --if-changed || true ;;
esac
shift
exec "$command" "$@"
