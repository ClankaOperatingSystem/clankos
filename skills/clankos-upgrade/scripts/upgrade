#!/usr/bin/env bash
# Upgrade one repository; keep its index and history unchanged.
set -euo pipefail
if [ $# -ne 2 ] || [ "$1" != --image ] || [[ ! $2 =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo 'Usage: upgrade --image vX.Y.Z' >&2
    exit 2
fi
export CLANKOS_TARGET_RELEASE=$2
target=ghcr.io/clankaoperatingsystem/clankos:$2
clankos=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/clankos
top=$(git rev-parse --show-toplevel) || exit 2
cd "$top"
export CLANKOS_IMAGE=${CLANKOS_IMAGE:-$target}
"$clankos" --check-pair
"$clankos" installation-edit . image "$target"
# Save intent before apply; a failed apply can be retried against this target.
exec "$clankos" apply-v1
