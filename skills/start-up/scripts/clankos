#!/bin/sh
# clankos COMMAND [ARG ...]
# Run one of ClankOS's commands from this skill, wherever the skill is
# linked: the commands are installed beside the skills. The command
# works on the directory this is run in, so run it by its path and do
# not change directory first.
# Exit: the command's own; 2 usage; 127 no such command.
if [ $# -eq 0 ]; then
    echo "Usage: clankos COMMAND [ARG ...]" >&2
    exit 2
fi
here=$(cd -- "$(dirname -- "$0")" && pwd -P) || exit 127
command=$here/../../../bin/$1
case $1 in
    */*) command= ;;
esac
if [ -z "$command" ] || [ ! -x "$command" ]; then
    echo "clankos: no such command: $1" >&2
    exit 127
fi
shift
exec "$command" "$@"
