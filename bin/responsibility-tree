#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'HELP'
Usage: responsibility-tree [--ask] [--responsibility NAME] ...
                           [--project NAME] ... [--product PATH=REMOTE] ...
       responsibility-tree --help

Add responsibilities, projects and products to the garden in the
working directory, in the ClankOS container.
docs/responsibility-tree.txt gives the protocol.

At a terminal with no option, and with --ask, it asks for each in
turn until an empty answer.

  --responsibility NAME   make the directory NAME with a configuration
                          and an intray, and declare it
  --project NAME          make the one-file project NAME.org where the
                          garden's projects belong
  --product PATH=REMOTE   declare the repository at REMOTE as mounted
                          at PATH; it is not cloned

Then updates Git's managed archive ignore rules and prints what
poslib's plan finds wrong in the tree, and what is still to clone.
Keeps existing configuration and content, and commits nothing.

Exit: 0 done, 1 a name or path was refused, 2 not a garden or usage;
125, 126 and 127 are clankos-run's.
HELP
}

case "${1:-}" in
    help|-h|--help) usage; exit 0 ;;
esac
# A directory scope shares its repository's Git metadata. Mount that
# repository so archive rules can be updated when invoked in a child.
runner="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/clankos-run"
if [ -z "${CLANKOS_WORKSPACE:-}" ]; then
    # Keep the image selected by the current scope before widening the mount.
    if [ -z "${CLANKOS_IMAGE:-}" ]; then
        selection=$("$runner" --show)
        CLANKOS_IMAGE=$(printf '%s\n' "$selection" | sed -n 's/^image //p')
        export CLANKOS_IMAGE
    fi
    CLANKOS_WORKSPACE=$(git rev-parse --show-toplevel) || exit 2
    export CLANKOS_WORKSPACE
fi
exec "$runner" responsibility-tree "$@"
